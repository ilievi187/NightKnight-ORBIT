{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NightKnight ORBIT",
  "version": "0.1.0",
  "identifier": "com.nightknight.orbit",
  "build": {
    "frontendDist": "../desktop/bootstrap",
    "devUrl": "http://127.0.0.1:8765",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NightKnight ORBIT",
        "width": 1520,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [
      "binaries/orbit-server",
      "binaries/orbit-mock-worker"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "shell": {}
  }
}
