# PyInstaller spec for ORBIT mock worker (separate onefile sidecar for the bundle)
# Provides a real worker process for fleet pairing demos (no fake metrics).

block_cipher = None
from pathlib import Path
SPEC_DIR = Path(SPECPATH)
ROOT = SPEC_DIR.parent

a = Analysis(
    [str(ROOT / 'tools' / 'mock-worker.py')],
    pathex=[str(ROOT)],
    binaries=[],
    datas=[],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=['tkinter'],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)
pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)
exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name='orbit-mock-worker',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
