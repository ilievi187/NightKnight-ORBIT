# OpenAI-compatible local model API (llama.cpp, Ollama /v1, LM Studio)
ORBIT_MODEL=heretic27-q4ks
ORBIT_BASE_URL=http://127.0.0.1:8080/v1
ORBIT_API_KEY=
# Files under this directory can be browsed/read; writing needs approval
ORBIT_WORKSPACE=/home/nightknight/Projects
# Local-only by default. NEVER expose publicly without authentication/reverse proxy.
ORBIT_BIND=127.0.0.1
ORBIT_PORT=8765
# M3 — local inference runtime. Optional: per-request timeout (seconds) and an
# extra list of named providers (JSON array, or `name=base_url[|model][|kind][|timeout];...`).
# When ORBIT_PROVIDERS is empty, the single provider above (ORBIT_BASE_URL/ORBIT_MODEL) is used.
ORBIT_TIMEOUT=15
# ORBIT_PROVIDERS=[{"name":"ollama","base_url":"http://127.0.0.1:11434","model":"heretic27:q4ks","kind":"ollama"},{"name":"llamacpp","base_url":"http://127.0.0.1:8080/v1","model":"heretic27-q4ks","kind":"llama_cpp"}]

# ORBIT Desktop SYSTEM tab shows probe metadata, not an automatic chat provider switch.
